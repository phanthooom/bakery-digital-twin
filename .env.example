# Скопируйте в .env при необходимости переопределить значения по умолчанию.
# Все значения ниже совпадают с docker-compose.yml и используются по умолчанию в коде.

# Безопасность сети: по умолчанию только локальный интерфейс 127.0.0.1
BIND_IP=127.0.0.1

# MQTT (Mosquitto)
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=bakery

# InfluxDB 2
INFLUX_URL=http://localhost:8086
INFLUX_USER=admin
INFLUX_PASSWORD=bakery-admin-pass
INFLUX_TOKEN=bakery-dev-token
INFLUX_ORG=bakery
INFLUX_BUCKET=bakery

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ANONYMOUS=true

# API
API_PORT=3001

# Симулятор
SIM_INTERVAL_MS=5000
# Сколько часов истории дозаписать при первом запуске (догоняет пропуск, как ESP32 с буфером)
SIM_BACKFILL_HOURS=6
# Средняя частота неисправностей на станок, раз в час
SIM_FAULTS_PER_HOUR=0.5
