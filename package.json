{
  "name": "bakery-digital-twin",
  "version": "0.1.0",
  "private": true,
  "description": "Цифровой двойник хлебопекарни: 3D-цех с живыми данными энергопотребления",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "simulator",
    "web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:sim": "npm run dev -w simulator",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p simulator && tsc -p web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.10.0"
  }
}
